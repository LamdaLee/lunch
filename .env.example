# Local development works without these values, using .local/lunchpass.sqlite.
# On Vercel, connect a PostgreSQL database and set these in Environment Variables.
# Never commit real values or paste database URLs / setup keys into chat.
DATABASE_URL=
SETUP_KEY=
COOKIE_SECURE=true
# 대전 훈련생 포털 연동 (선택). 둘 다 있어야 켜집니다. PORTAL_SECRET 은 포털과 같은 32자 이상 값.
PORTAL_URL=
PORTAL_SECRET=
